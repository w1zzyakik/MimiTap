<Window x:Class="MimiTap.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MimiTap"
        Title="MimiTap"
        Icon="pack://application:,,,/Assets/MimiTap.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <Grid x:Name="Root">
        <!-- затемнение фона, чтобы Мими и подсказка читались -->
        <Rectangle x:Name="Scrim" Fill="#B3000000" />

        <!-- рамка вокруг картинки на шагах про Мими -->
        <Border x:Name="Highlight" BorderBrush="{StaticResource AccentHoverBrush}" BorderThickness="2" CornerRadius="12"
                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
            <Border Background="#22FFFFFF" CornerRadius="12" />
        </Border>

        <!-- карточка-подсказка -->
        <Border x:Name="Callout" Width="440" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="14" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.65" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/MimiTap.ico" Width="22" Height="22" VerticalAlignment="Center" />
                    <TextBlock x:Name="StepLabel" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentHoverBrush}" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock x:Name="CalloutTitle" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="CalloutText" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="20" />

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Content="{loc:Tr TutorialBack}" HorizontalAlignment="Left"
                            Click="OnBack" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SkipButton" Content="{loc:Tr TutorialSkip}" Click="OnSkip" />
                        <Button x:Name="NextButton" Content="{loc:Tr TutorialNext}" Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0" MinWidth="120" Click="OnNext" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
