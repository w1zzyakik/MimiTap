<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MimiTap</AssemblyName>
    <RootNamespace>MimiTap</RootNamespace>
    <ApplicationIcon>Assets\MimiTap.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Version>1.1.0</Version>
    <Product>MimiTap</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\1.png" />
    <Resource Include="Assets\2.png" />
    <Resource Include="Assets\p2_1.png" />
    <Resource Include="Assets\p2_2.png" />
    <Resource Include="Assets\MimiTap.ico" />
  </ItemGroup>

  <!-- словари локализации: ru.json, en.json, … встраиваются в сборку -->
  <ItemGroup>
    <EmbeddedResource Include="Localization\Strings\*.json" />
  </ItemGroup>

  <!-- Установщик — отдельный проект в подпапке installer. Исключаем его файлы
       из сборки основного приложения, иначе SDK-глоб затягивает их дважды. -->
  <ItemGroup>
    <Compile Remove="installer\**" />
    <Page Remove="installer\**" />
    <ApplicationDefinition Remove="installer\**" />
    <None Remove="installer\**" />
    <Resource Remove="installer\**" />
    <EmbeddedResource Remove="installer\**" />
  </ItemGroup>

</Project>