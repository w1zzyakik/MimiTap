<Window x:Class="MimiTapSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MimiTap"
        Title="MimiTap"
        Icon="pack://application:,,,/Assets/MimiTap.ico"
        Width="660" Height="580"
        MinWidth="660" MinHeight="580"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <!-- мягкое свечение снаружи -->
        <Border CornerRadius="30" Margin="6" Background="#338B5CF6" Opacity="0.35" />

        <Border x:Name="Card" CornerRadius="24" Margin="3"
                Background="{StaticResource BackgroundGradient}"
                BorderBrush="#4D8B5CF6" BorderThickness="1">
                <Border.Clip>
                    <RectangleGeometry RadiusX="24" RadiusY="24" Rect="0,0,2000,2000" />
                </Border.Clip>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- шапка -->
                <Grid Grid.Row="0" Margin="22,18,16,0" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentGradient}">
                        <Border.Effect>
                            <DropShadowEffect Color="#8B5CF6" BlurRadius="16" ShadowDepth="0" Opacity="0.55" />
                        </Border.Effect>
                        <Image Source="pack://application:,,,/Assets/MimiTap.ico" Width="26" Height="26" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MimiTap" Style="{StaticResource H1}" FontSize="18" />
                        <TextBlock x:Name="SubtitleText" Text="{loc:Tr InstallerSubtitle}" Style="{StaticResource H2}" FontSize="12" Margin="0,1,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource WindowCloseButton}" Click="OnCloseClick" />
                </Grid>

                <Rectangle Grid.Row="0" Height="1" Margin="22,18,22,0" VerticalAlignment="Bottom" Fill="{StaticResource LineBrush}" />

                <!-- содержимое -->
                <Grid Grid.Row="1" Margin="22,18,22,0">

                    <!-- шаг 1: выбор -->
                    <StackPanel x:Name="IntroPanel" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,14"
                                   Text="{loc:Tr InstallerIntro}" TextWrapping="Wrap" />

                        <Border CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{loc:Tr InstallerFolder}" Style="{StaticResource H2}" />
                                        <TextBlock x:Name="PathText" Style="{StaticResource Body}" FontFamily="Consolas" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button x:Name="BrowseButton" Grid.Column="1" Content="{loc:Tr InstallerBrowse}" Style="{StaticResource GhostButton}" Padding="14,7" FontSize="12.5" VerticalAlignment="Center" Click="OnBrowseClick" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" CornerRadius="14" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="14,8">
                            <StackPanel>
                                <CheckBox x:Name="AutoStartBox" Content="{loc:Tr InstallerAutoStart}" IsChecked="True" />
                                <CheckBox x:Name="DesktopBox" Content="{loc:Tr InstallerDesktop}" />
                                <CheckBox x:Name="RunBox" Content="{loc:Tr InstallerRun}" />
                                <CheckBox x:Name="RemoveDataBox" Content="{loc:Tr InstallerRemoveData}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource H2}" FontSize="12" Margin="2,14,0,0" TextWrapping="Wrap"
                                   Text="{loc:Tr InstallerFooter}" />
                    </StackPanel>

                    <!-- шаг 2: установка -->
                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Top">
                        <TextBlock x:Name="StepText" Style="{StaticResource Body}" Margin="0,0,0,10" Text="{loc:Tr InstallerPreparing}" />
                        <ProgressBar x:Name="Bar" Style="{StaticResource ProgressBar}" IsIndeterminate="True" Minimum="0" Maximum="100" />
                        <Border Margin="0,16,0,0" CornerRadius="12" Background="#12000000" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12" Height="196">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                                <TextBlock x:Name="LogText" Style="{StaticResource H2}" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource FaintBrush}" TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- шаг 3: готово -->
                    <StackPanel x:Name="DonePanel" Visibility="Collapsed" VerticalAlignment="Center">
                        <Border Width="62" Height="62" CornerRadius="31" HorizontalAlignment="Center"
                                Background="#338B5CF6" x:Name="DoneBadge">
                            <Path Stretch="Uniform" Width="26" Height="26"
                                  Data="M 0,7 L 4.4,11.4 L 13,1.6"
                                  Stroke="#FFD8CCFF" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <TextBlock x:Name="DoneTitle" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,18,0,0" Text="{loc:Tr InstallerInstalled}" />
                        <TextBlock x:Name="DoneText" Style="{StaticResource H2}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>

                <!-- низ -->
                <Grid Grid.Row="2" Margin="22,16,22,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FooterHint" Grid.Column="0" Style="{StaticResource H2}" FontSize="11.5" VerticalAlignment="Center" Text="" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SecondaryButton" Content="{loc:Tr InstallerCancel}" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Padding="20,11" Click="OnSecondaryClick" />
                        <Button x:Name="PrimaryButton" Content="{loc:Tr InstallerInstall}" Style="{StaticResource PrimaryButton}" Click="OnPrimaryClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
