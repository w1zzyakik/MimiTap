<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MimiTapSetup</AssemblyName>
    <RootNamespace>MimiTapSetup</RootNamespace>
    <ApplicationIcon>..\..\Assets\MimiTap.ico</ApplicationIcon>
    <ApplicationManifest>..\..\app.manifest</ApplicationManifest>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Version>1.1.0</Version>
    <Product>MimiTap Setup</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- движок локализации и словари берём из основного проекта, чтобы не дублировать строки -->
    <Compile Include="..\..\Localization\Localization.cs" Link="Localization\Localization.cs" />
    <EmbeddedResource Include="..\..\Localization\Strings\ru.json" LogicalName="MimiTapSetup.Localization.Strings.ru.json" />
    <EmbeddedResource Include="..\..\Localization\Strings\en.json" LogicalName="MimiTapSetup.Localization.Strings.en.json" />
    <EmbeddedResource Include="..\..\Localization\Strings\es.json" LogicalName="MimiTapSetup.Localization.Strings.es.json" />
    <EmbeddedResource Include="..\..\Localization\Strings\pt-BR.json" LogicalName="MimiTapSetup.Localization.Strings.pt-BR.json" />
    <EmbeddedResource Include="..\..\Localization\Strings\uk.json" LogicalName="MimiTapSetup.Localization.Strings.uk.json" />
    <EmbeddedResource Include="..\..\Localization\Strings\pl.json" LogicalName="MimiTapSetup.Localization.Strings.pl.json" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\Assets\MimiTap.ico" Link="Assets\MimiTap.ico" />
    <EmbeddedResource Include="..\..\publish\MimiTap.exe" LogicalName="Payload.MimiTap.exe" />
  </ItemGroup>

</Project>
