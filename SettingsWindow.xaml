<Window x:Class="MimiTap.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MimiTap"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="MimiTap"
        Icon="pack://application:,,,/Assets/MimiTap.ico"
        Width="820"
        Height="640"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}" CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── шапка ───────────────────────────────── -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="TitleIcon" Grid.Column="0" Width="22" Height="22" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="MimiTap" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#x2015;" FontSize="14" MinWidth="40" MinHeight="30"
                            ToolTip="{loc:Tr WinMinimize}" automation:AutomationProperties.Name="{loc:Tr WinMinimizeShort}" Click="HideToTray" />
                    <Button Style="{StaticResource TitleBarButton}" Content="&#x2715;" FontSize="15" MinWidth="40" MinHeight="30"
                            ToolTip="{loc:Tr WinClose}" automation:AutomationProperties.Name="{loc:Tr WinCloseShort}" Click="HideToTray" />
                </StackPanel>
            </Grid>

            <!-- ── тело: навигация слева, содержимое справа ─ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="198" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="12,14,12,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="11,0,0,8" Opacity="0.7">MIMITAP</TextBlock>
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True"
                                     Tag="General" Checked="OnNavChanged" Content="{loc:Tr NavGeneral}" />
                        <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="Appearance" Checked="OnNavChanged" Content="{loc:Tr NavAppearance}" />
                        <RadioButton x:Name="NavClicks" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="Clicks" Checked="OnNavChanged" Content="{loc:Tr NavClicks}" />
                        <RadioButton x:Name="NavSound" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="Sound" Checked="OnNavChanged" Content="{loc:Tr NavSound}" />
                        <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="System" Checked="OnNavChanged" Content="{loc:Tr NavSystem}" />
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="Nav"
                                     Tag="About" Checked="OnNavChanged" Content="{loc:Tr NavAbout}" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="22,16,14,16">
                    <Grid>

                        <!-- ── Общее ─────────────────────── -->
                        <StackPanel x:Name="SectionGeneral">
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="132" Height="132" Background="{StaticResource FieldBrush}"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
                                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,2" Text="{loc:Tr CardPreviewTitle}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr CardPreviewHint}" />
                                        <CheckBox x:Name="PreviewClickBox" Content="{loc:Tr CardPreviewPreviewClick}" Margin="0,10,0,0"
                                                  Checked="OnPreviewChanged" Unchecked="OnPreviewChanged" />

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr CardPreviewImageIdle}" VerticalAlignment="Center" Margin="0,0,8,4" />
                                            <Button Grid.Row="0" Grid.Column="1" Content="{loc:Tr BtnChoose}" Margin="0,0,6,4" Click="PickIdleImage" />
                                            <Button Grid.Row="0" Grid.Column="2" Content="{loc:Tr BtnReset}" Margin="0,0,0,4" Click="ResetIdleImage" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr CardPreviewImageClick}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Grid.Row="1" Grid.Column="1" Content="{loc:Tr BtnChoose}" Margin="0,0,6,0" Click="PickClickImage" />
                                            <Button Grid.Row="1" Grid.Column="2" Content="{loc:Tr BtnReset}" Click="ResetClickImage" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{loc:Tr CardPreviewAssets}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button x:Name="ShowOverlayButton" Content="{loc:Tr BtnHideOverlay}" Click="ToggleOverlayVisibility" MinWidth="150" />
                                        <Button Content="{loc:Tr BtnCenter}" Click="CenterOverlay" MinWidth="150" Margin="0,8,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,10,0,0" Text="{loc:Tr CardPreviewRmb}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr PresetTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="{loc:Tr PresetHint}" />
                                    <StackPanel x:Name="PresetsList" />
                                    <Button x:Name="AddPresetButton" Content="{loc:Tr PresetAdd}" HorizontalAlignment="Left"
                                            Margin="0,10,0,0" Click="AddPreset" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr CardLanguageTitle}" />
                                    <ComboBox x:Name="LanguageBox" Width="250" HorizontalAlignment="Left" SelectionChanged="OnLanguageChanged">
                                        <ComboBoxItem Content="{loc:Tr LangAuto}" Tag="" />
                                        <ComboBoxItem Content="{loc:Tr LangRu}" Tag="ru" />
                                        <ComboBoxItem Content="{loc:Tr LangEn}" Tag="en" />
                                        <ComboBoxItem Content="{loc:Tr LangEs}" Tag="es" />
                                        <ComboBoxItem Content="{loc:Tr LangPt}" Tag="pt-BR" />
                                        <ComboBoxItem Content="{loc:Tr LangUk}" Tag="uk" />
                                        <ComboBoxItem Content="{loc:Tr LangPl}" Tag="pl" />
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{loc:Tr CardLanguageHint}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Внешний вид ───────────────── -->
                        <StackPanel x:Name="SectionAppearance" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr CardSizeTitle}" />
                                    <CheckBox x:Name="UseImageSizeBox" Content="{loc:Tr CardSizeUseImage}"
                                              Checked="OnSizeModeChanged" Unchecked="OnSizeModeChanged" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr LabelWidth}" Width="88" VerticalAlignment="Center" />
                                        <TextBox x:Name="WidthBox" Grid.Row="0" Grid.Column="1" Margin="0,0,10,8" Text="220" LostFocus="OnSizeChanged" />

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Tr LabelHeight}" Width="88" VerticalAlignment="Center" />
                                        <TextBox x:Name="HeightBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" Text="220" LostFocus="OnSizeChanged" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr LabelScale}" Width="88" VerticalAlignment="Center" />
                                        <ComboBox x:Name="StretchBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" SelectionChanged="OnStretchChanged">
                                            <ComboBoxItem Content="{loc:Tr StretchUniform}" Tag="Uniform" />
                                            <ComboBoxItem Content="{loc:Tr StretchUniformToFill}" Tag="UniformToFill" />
                                            <ComboBoxItem Content="{loc:Tr StretchFill}" Tag="Fill" />
                                            <ComboBoxItem Content="{loc:Tr StretchNone}" Tag="None" />
                                            <ComboBoxItem Content="{loc:Tr StretchCenter}" Tag="Center" />
                                        </ComboBox>
                                    </Grid>
                                    <CheckBox x:Name="LockAspectBox" Content="{loc:Tr CardSizeLockAspect}" IsChecked="True" />

                                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Tr LabelOpacity}" Width="88" VerticalAlignment="Center" />
                                        <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.1" Maximum="1" Value="1" ValueChanged="OnOpacityChanged" />
                                        <TextBlock x:Name="OpacityText" Grid.Column="2" Text="100%" Width="48" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr CardPositionTitle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr LabelScreen}" Width="88" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ScreenBox" Grid.Row="0" Grid.Column="1" Margin="0,0,10,8" SelectionChanged="OnAnchorChanged">
                                            <ComboBoxItem Content="{loc:Tr ScreenPrimary}" Tag="Primary" />
                                            <ComboBoxItem Content="{loc:Tr ScreenVirtual}" Tag="Virtual" />
                                            <ComboBoxItem Content="{loc:Tr ScreenCursor}" Tag="Cursor" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Tr LabelAnchor}" Width="88" VerticalAlignment="Center" />
                                        <ComboBox x:Name="AnchorBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" SelectionChanged="OnAnchorChanged">
                                            <ComboBoxItem Content="{loc:Tr AnchorFree}" Tag="Free" />
                                            <ComboBoxItem Content="{loc:Tr AnchorCenter}" Tag="Center" />
                                            <ComboBoxItem Content="{loc:Tr AnchorTopLeft}" Tag="TopLeft" />
                                            <ComboBoxItem Content="{loc:Tr AnchorTopCenter}" Tag="TopCenter" />
                                            <ComboBoxItem Content="{loc:Tr AnchorTopRight}" Tag="TopRight" />
                                            <ComboBoxItem Content="{loc:Tr AnchorLeftCenter}" Tag="LeftCenter" />
                                            <ComboBoxItem Content="{loc:Tr AnchorRightCenter}" Tag="RightCenter" />
                                            <ComboBoxItem Content="{loc:Tr AnchorBottomLeft}" Tag="BottomLeft" />
                                            <ComboBoxItem Content="{loc:Tr AnchorBottomCenter}" Tag="BottomCenter" />
                                            <ComboBoxItem Content="{loc:Tr AnchorBottomRight}" Tag="BottomRight" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr LabelXy}" Width="88" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBox x:Name="PosXBox" Width="86" Text="" />
                                            <TextBox x:Name="PosYBox" Width="86" Margin="10,0,0,0" Text="" />
                                            <Button Content="{loc:Tr BtnRememberCurrent}" Margin="10,0,0,0" Click="SaveCurrentPosition" />
                                            <Button Content="{loc:Tr BtnClear}" Margin="8,0,0,0" Click="ClearSavedPosition" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource Hint}" Text="{loc:Tr CardPositionHint}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Клики ─────────────────────── -->
                        <StackPanel x:Name="SectionClicks" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr CardClickTitle}" />

                                    <CheckBox x:Name="MouseHookEnabledBox" Content="{loc:Tr CardClickHook}" IsChecked="True" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Tr LabelTriggers}" Width="110" VerticalAlignment="Center" />
                                        <ComboBox x:Name="HitTestBox" Grid.Column="1" SelectionChanged="OnHitTestChanged">
                                            <ComboBoxItem Content="{loc:Tr HitTestScreen}" Tag="Screen" />
                                            <ComboBoxItem Content="{loc:Tr HitTestWindow}" Tag="Window" />
                                            <ComboBoxItem Content="{loc:Tr HitTestImage}" Tag="Image" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Tr LabelPadding}" Width="110" VerticalAlignment="Center" />
                                        <Slider x:Name="ZoneSlider" Grid.Column="1" Minimum="0" Maximum="200" Value="40"
                                                IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnZoneChanged" />
                                        <TextBlock x:Name="ZoneValueText" Grid.Column="2" Text="40 px" Width="64" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock x:Name="ZoneInfoText" Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{loc:Tr CardClickZoneInfo}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{loc:Tr CardClickScreenHint}" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Tr LabelOnClick}" Width="110" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ClickBehaviorBox" Grid.Column="1" Margin="0,0,10,0" SelectionChanged="OnClickModeChanged">
                                            <ComboBoxItem Content="{loc:Tr ClickHold}" Tag="Hold" />
                                            <ComboBoxItem Content="{loc:Tr ClickTimed}" Tag="Timed" />
                                            <ComboBoxItem Content="{loc:Tr ClickToggle}" Tag="Toggle" />
                                        </ComboBox>
                                        <TextBox x:Name="ClickDurationBox" Grid.Column="2" Width="64" Text="150" IsEnabled="False" />
                                        <TextBlock Grid.Column="3" Text="{loc:Tr UnitMs}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{loc:Tr CardClickHoldHint}" />

                                    <CheckBox x:Name="DragToMoveBox" Content="{loc:Tr CardClickDragToMove}" Margin="0,8,0,0" />
                                    <CheckBox x:Name="ClickThroughBox" Content="{loc:Tr CardClickClickThrough}" />
                                    <CheckBox x:Name="NoActivateBox" Content="{loc:Tr CardClickNoActivate}" IsChecked="True" />
                                    <CheckBox x:Name="AlwaysOnTopBox" Content="{loc:Tr CardClickAlwaysOnTop}" IsChecked="True" />
                                    <CheckBox x:Name="StartVisibleBox" Content="{loc:Tr CardClickStartVisible}" IsChecked="True" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr BindTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="{loc:Tr BindHint}" />

                                    <UniformGrid x:Name="BindingsGrid" Columns="2" />

                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{loc:Tr BindClear}" />

                                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12,0,10" />

                                    <CheckBox x:Name="ReactAllBox" Style="{StaticResource SwitchCheckBox}" Content="{loc:Tr BindReactAll}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{loc:Tr BindReactAllHint}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Звук ──────────────────────── -->
                        <StackPanel x:Name="SectionSound" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr CardSoundTitle}" />
                                    <CheckBox x:Name="SoundEnabledBox" Content="{loc:Tr CardSoundEnable}" IsChecked="True" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SoundPathBox" Grid.Column="0" Margin="0,0,8,0" IsReadOnly="True" />
                                        <Button Grid.Column="1" Content="{loc:Tr BtnChoose}" Margin="0,0,8,0" Click="PickSound" />
                                        <Button Grid.Column="2" Content="{loc:Tr BtnReset}" Click="ResetSound" />
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Tr LabelVolume}" Width="110" VerticalAlignment="Center" />
                                        <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.8" ValueChanged="OnVolumeChanged" />
                                        <TextBlock x:Name="VolumeText" Grid.Column="2" Text="80%" Width="48" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Tr LabelDuration}" Width="110" VerticalAlignment="Center" />
                                        <Slider x:Name="MaxSecondsSlider" Grid.Column="1" Minimum="0.1" Maximum="1" Value="1"
                                                IsSnapToTickEnabled="True" TickFrequency="0.05" ValueChanged="OnMaxSecondsChanged" />
                                        <TextBlock x:Name="MaxSecondsText" Grid.Column="2" Text="1.00 с" Width="56" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{loc:Tr BtnListen}" Click="TestSound" />
                                        <TextBlock x:Name="SoundInfoText" Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="{loc:Tr CardSoundFormats}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── Система ───────────────────── -->
                        <StackPanel x:Name="SectionSystem" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr CardSystemTitle}" />
                                    <CheckBox x:Name="AutoStartBox" Content="{loc:Tr CardSystemAutostart}" />

                                    <CheckBox x:Name="HotkeyEnabledBox" Content="{loc:Tr CardSystemHotkey}" IsChecked="True" Margin="0,10,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="30,4,0,0">
                                        <CheckBox x:Name="HotkeyCtrlBox" Content="Ctrl" IsChecked="True" />
                                        <CheckBox x:Name="HotkeyAltBox" Content="Alt" IsChecked="True" Margin="14,5,14,5" />
                                        <CheckBox x:Name="HotkeyShiftBox" Content="Shift" />
                                        <ComboBox x:Name="HotkeyKeyBox" Width="110" Margin="18,0,0,0">
                                            <ComboBoxItem Content="M" Tag="M" />
                                            <ComboBoxItem Content="T" Tag="T" />
                                            <ComboBoxItem Content="V" Tag="V" />
                                            <ComboBoxItem Content="B" Tag="B" />
                                            <ComboBoxItem Content="F1" Tag="F1" />
                                            <ComboBoxItem Content="F2" Tag="F2" />
                                            <ComboBoxItem Content="F3" Tag="F3" />
                                            <ComboBoxItem Content="F4" Tag="F4" />
                                            <ComboBoxItem Content="F8" Tag="F8" />
                                            <ComboBoxItem Content="Space" Tag="Space" />
                                        </ComboBox>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="{loc:Tr CardSystemHotkeyHint}" />

                                    <Button Content="{loc:Tr BtnResetAll}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                            Style="{StaticResource BaseButton}" Foreground="{StaticResource DangerBrush}" Click="ResetAll" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ── О программе ───────────────── -->
                        <StackPanel x:Name="SectionAbout" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Assets/MimiTap.ico" Width="52" Height="52" VerticalAlignment="Top" />
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="MimiTap" FontSize="20" FontWeight="Bold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{loc:Tr AboutTagline}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0" Text="{loc:Tr AboutText}" />
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,16,0,4" Text="{loc:Tr AboutCharacterTitle}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr AboutCharacterText}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Foreground="{StaticResource AccentHoverBrush}" Text="{loc:Tr AboutRights}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Caption}" Text="{loc:Tr AboutVersion}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionText" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}" Margin="0,7,0,0" Text="{loc:Tr AboutAuthor}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" Text="{loc:Tr AboutAuthorValue}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Caption}" Margin="0,12,0,0" Text="{loc:Tr AboutSite}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" TextWrapping="Wrap">
                                            <Hyperlink NavigateUri="https://w1zzyakik.github.io/MimiTap/" Foreground="{StaticResource AccentHoverBrush}"><Run Text="{loc:Tr AboutSite}" /></Hyperlink>
                                            <Run Text="   ·   " Foreground="{StaticResource MutedBrush}" />
                                            <Hyperlink NavigateUri="https://github.com/w1zzyakik/MimiTap" Foreground="{StaticResource AccentHoverBrush}"><Run Text="{loc:Tr AboutGithub}" /></Hyperlink>
                                            <Run Text="   ·   " Foreground="{StaticResource MutedBrush}" />
                                            <Hyperlink NavigateUri="https://t.me/MimiTapp" Foreground="{StaticResource AccentHoverBrush}"><Run Text="{loc:Tr AboutTelegram}" /></Hyperlink>
                                        </TextBlock>
                                    </Grid>

                                    <Button Content="{loc:Tr BtnTutorial}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnShowTutorial" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ── футер ─────────────────────────────────── -->
            <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Background="#110C1A">
                <Grid Margin="18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center" Text="{loc:Tr FooterStatus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{loc:Tr BtnExit}" Click="ExitApp" />
                        <Button Content="{loc:Tr BtnSave}" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="10,0,0,0" Click="SaveSettings" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
