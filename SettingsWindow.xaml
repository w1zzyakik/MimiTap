<Window x:Class="MimiTap.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="MimiTap"
        Icon="pack://application:,,,/Assets/MimiTap.ico"
        Width="740"
        Height="860"
        MinWidth="660"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}" CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="TitleIcon" Grid.Column="0" Width="22" Height="22" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="MimiTap" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#x2015;" FontSize="14" MinWidth="40" MinHeight="30"
                            ToolTip="Свернуть в трей" automation:AutomationProperties.Name="Свернуть" Click="HideToTray" />
                    <Button Style="{StaticResource TitleBarButton}" Content="&#x2715;" FontSize="15" MinWidth="40" MinHeight="30"
                            ToolTip="Закрыть (свернуть в трей)" automation:AutomationProperties.Name="Закрыть" Click="HideToTray" />
                </StackPanel>
            </Grid>


            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="22,4,8,8">
                    <StackPanel>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="132" Height="132" Background="{StaticResource FieldBrush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
                                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,2">Так это выглядит поверх окон</TextBlock>
                                    <TextBlock Style="{StaticResource Hint}">Размер, положение и картинки применяются сразу. Нажмите «Сохранить», чтобы запомнить их при следующем запуске.</TextBlock>
                                    <CheckBox x:Name="PreviewClickBox" Content="Предпросмотр картинки 2.png" Margin="0,10,0,0"
                                              Checked="OnPreviewChanged" Unchecked="OnPreviewChanged" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="1.png — обычное состояние" VerticalAlignment="Center" Margin="0,0,8,4" />
                                        <Button Grid.Row="0" Grid.Column="1" Content="Выбрать" Margin="0,0,6,4" Click="PickIdleImage" />
                                        <Button Grid.Row="0" Grid.Column="2" Content="Сброс" Margin="0,0,0,4" Click="ResetIdleImage" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="2.png — после клика" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Grid.Row="1" Grid.Column="1" Content="Выбрать" Margin="0,0,6,0" Click="PickClickImage" />
                                        <Button Grid.Row="1" Grid.Column="2" Content="Сброс" Click="ResetClickImage" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                               Text="Свои файлы можно положить в %AppData%\MimiTap\assets как 1.png и 2.png." />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button x:Name="ShowOverlayButton" Content="Скрыть картинку" Click="ToggleOverlayVisibility" MinWidth="150" />
                                    <Button Content="Центрировать на экране" Click="CenterOverlay" MinWidth="150" Margin="0,8,0,0" />
                                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,10,0,0" Text="ПКМ по картинке — настройки" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}">Размер</TextBlock>
                                <CheckBox x:Name="UseImageSizeBox" Content="Размер как у изображения (по 1.png)"
                                          Checked="OnSizeModeChanged" Unchecked="OnSizeModeChanged" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ширина, px" Width="88" VerticalAlignment="Center" />
                                    <TextBox x:Name="WidthBox" Grid.Row="0" Grid.Column="1" Margin="0,0,10,8" Text="220"
                                             LostFocus="OnSizeChanged" />

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Высота, px" Width="88" VerticalAlignment="Center" />
                                    <TextBox x:Name="HeightBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" Text="220"
                                             LostFocus="OnSizeChanged" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Масштаб" Width="88" VerticalAlignment="Center" />
                                    <ComboBox x:Name="StretchBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8" SelectionChanged="OnStretchChanged">
                                        <ComboBoxItem Content="Пропорционально" Tag="Uniform" />
                                        <ComboBoxItem Content="Заполнить с обрезкой" Tag="UniformToFill" />
                                        <ComboBoxItem Content="Растянуть" Tag="Fill" />
                                        <ComboBoxItem Content="Не менять (как есть)" Tag="None" />
                                        <ComboBoxItem Content="По центру (как есть)" Tag="Center" />
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="LockAspectBox" Content="Сохранять пропорции при изменении ширины" IsChecked="True" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}">Положение</TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Экран" Width="88" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ScreenBox" Grid.Row="0" Grid.Column="1" Margin="0,0,10,8" SelectionChanged="OnAnchorChanged">
                                        <ComboBoxItem Content="Основной" Tag="Primary" />
                                        <ComboBoxItem Content="Рабочий стол (все мониторы)" Tag="Virtual" />
                                        <ComboBoxItem Content="Там, где курсор" Tag="Cursor" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Привязка" Width="88" VerticalAlignment="Center" />
                                    <ComboBox x:Name="AnchorBox" Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" SelectionChanged="OnAnchorChanged">
                                        <ComboBoxItem Content="Свободная (запомнить X / Y)" Tag="Free" />
                                        <ComboBoxItem Content="Центр экрана" Tag="Center" />
                                        <ComboBoxItem Content="Сверху слева" Tag="TopLeft" />
                                        <ComboBoxItem Content="Сверху по центру" Tag="TopCenter" />
                                        <ComboBoxItem Content="Сверху справа" Tag="TopRight" />
                                        <ComboBoxItem Content="Слева по центру" Tag="LeftCenter" />
                                        <ComboBoxItem Content="Справа по центру" Tag="RightCenter" />
                                        <ComboBoxItem Content="Снизу слева" Tag="BottomLeft" />
                                        <ComboBoxItem Content="Снизу по центру" Tag="BottomCenter" />
                                        <ComboBoxItem Content="Снизу справа" Tag="BottomRight" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="X / Y, px" Width="88" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox x:Name="PosXBox" Width="86" Text="" />
                                        <TextBox x:Name="PosYBox" Width="86" Margin="10,0,0,0" Text="" />
                                        <Button Content="Запомнить текущее" Margin="10,0,0,0" Click="SaveCurrentPosition" />
                                        <Button Content="Очистить" Margin="8,0,0,0" Click="ClearSavedPosition" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource Hint}"
                                               Text="«Запомнить текущее» записывает текущее положение картинки. Пустые X / Y — положение вычисляется по привязке." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}">Реакция на клики</TextBlock>

                                <CheckBox x:Name="MouseHookEnabledBox" Content="Отслеживать клики мыши по всей системе" IsChecked="True" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Срабатывает" Width="110" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HitTestBox" Grid.Column="1" SelectionChanged="OnHitTestChanged">
                                        <ComboBoxItem Content="Весь экран — клик где угодно" Tag="Screen" />
                                        <ComboBoxItem Content="Весь квадрат окна картинки" Tag="Window" />
                                        <ComboBoxItem Content="Только непрозрачные пиксели картинки" Tag="Image" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Запас вокруг" Width="110" VerticalAlignment="Center" />
                                    <Slider x:Name="ZoneSlider" Grid.Column="1" Minimum="0" Maximum="200" Value="40"
                                            IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnZoneChanged" />
                                    <TextBlock x:Name="ZoneValueText" Grid.Column="2" Text="40 px" Width="64" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock x:Name="ZoneInfoText" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="Зона клика — прямоугольник вокруг картинки; клик по «воздуху» тоже переключает картинку." />

                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="В режиме «Весь экран» переключает любой клик в любом месте: в игре, в браузере, в любой программе. Пока открыто окно настроек, клик засчитывается только по картинке. Перетаскивание мышью работает только за саму картинку." />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="По клику" Width="110" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ClickBehaviorBox" Grid.Column="1" Margin="0,0,10,0" SelectionChanged="OnClickModeChanged">
                                        <ComboBoxItem Content="Держать 2.png, пока зажата ЛКМ" Tag="Hold" />
                                        <ComboBoxItem Content="Показывать 2.png, потом вернуть 1.png" Tag="Timed" />
                                        <ComboBoxItem Content="Переключать 1.png и 2.png" Tag="Toggle" />
                                    </ComboBox>
                                    <TextBox x:Name="ClickDurationBox" Grid.Column="2" Width="64" Text="150" IsEnabled="False" />
                                    <TextBlock Grid.Column="3" Text="мс" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="«Держать 2.png»: пока левая кнопка мыши зажата — 2.png, как только отпущена — сразу 1.png, независимо от того, сколько держали. Остальные режимы срабатывают в момент отпускания." />

                                <CheckBox x:Name="DragToMoveBox" Content="Перетаскивать картинку мышью (зажать ЛКМ и тянуть)" Margin="0,8,0,0" />
                                <CheckBox x:Name="ClickThroughBox" Content="Клики проходят насквозь (приложение под картинкой получает клик)" />
                                <CheckBox x:Name="NoActivateBox" Content="Не забирать фокус у других окон" IsChecked="True" />
                                <CheckBox x:Name="AlwaysOnTopBox" Content="Поверх всех окон" IsChecked="True" />
                                <CheckBox x:Name="StartVisibleBox" Content="Показывать картинку при запуске" IsChecked="True" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Прозрачность" Width="110" VerticalAlignment="Center" />
                                    <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.1" Maximum="1" Value="1"
                                            ValueChanged="OnOpacityChanged" />
                                    <TextBlock x:Name="OpacityText" Grid.Column="2" Text="100%" Width="48" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}">Звук нажатия</TextBlock>
                                <CheckBox x:Name="SoundEnabledBox" Content="Включить звук" IsChecked="True" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SoundPathBox" Grid.Column="0" Margin="0,0,8,0" IsReadOnly="True" />
                                    <Button Grid.Column="1" Content="Выбрать" Margin="0,0,8,0" Click="PickSound" />
                                    <Button Grid.Column="2" Content="Сброс" Click="ResetSound" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Громкость" Width="110" VerticalAlignment="Center" />
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0.8"
                                            ValueChanged="OnVolumeChanged" />
                                    <TextBlock x:Name="VolumeText" Grid.Column="2" Text="80%" Width="48" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Длительность" Width="110" VerticalAlignment="Center" />
                                    <Slider x:Name="MaxSecondsSlider" Grid.Column="1" Minimum="0.1" Maximum="1" Value="1"
                                            IsSnapToTickEnabled="True" TickFrequency="0.05"
                                            ValueChanged="OnMaxSecondsChanged" />
                                    <TextBlock x:Name="MaxSecondsText" Grid.Column="2" Text="1.00 с" Width="56" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Прослушать" Click="TestSound" />
                                    <TextBlock x:Name="SoundInfoText" Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="Форматы: wav, mp3, m4a, wma, aac. Длинные файлы автоматически обрезаются (максимум 1 секунда)." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}">Система</TextBlock>
                                <CheckBox x:Name="AutoStartBox" Content="Запускать вместе с Windows" />

                                <CheckBox x:Name="HotkeyEnabledBox" Content="Горячая клавиша: показать / скрыть картинку" IsChecked="True" Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="30,4,0,0">
                                    <CheckBox x:Name="HotkeyCtrlBox" Content="Ctrl" IsChecked="True" />
                                    <CheckBox x:Name="HotkeyAltBox" Content="Alt" IsChecked="True" Margin="14,5,14,5" />
                                    <CheckBox x:Name="HotkeyShiftBox" Content="Shift" />
                                    <ComboBox x:Name="HotkeyKeyBox" Width="110" Margin="18,0,0,0">
                                        <ComboBoxItem Content="M" Tag="M" />
                                        <ComboBoxItem Content="T" Tag="T" />
                                        <ComboBoxItem Content="V" Tag="V" />
                                        <ComboBoxItem Content="B" Tag="B" />
                                        <ComboBoxItem Content="F1" Tag="F1" />
                                        <ComboBoxItem Content="F2" Tag="F2" />
                                        <ComboBoxItem Content="F3" Tag="F3" />
                                        <ComboBoxItem Content="F4" Tag="F4" />
                                        <ComboBoxItem Content="F8" Tag="F8" />
                                        <ComboBoxItem Content="Space" Tag="Space" />
                                    </ComboBox>
                                </StackPanel>

                                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                           Text="Горячая клавиша — единственный способ управления, когда картинка неактивна. ПКМ по картинке или по значку в трее открывает настройки." />

                                <Button Content="Сбросить все настройки" HorizontalAlignment="Left" Margin="0,14,0,0"
                                        Style="{StaticResource BaseButton}" Foreground="{StaticResource DangerBrush}" Click="ResetAll" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="1" Width="10">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" IsHitTestVisible="False">
                        <Grid />
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Background="#12151B">
                <Grid Margin="18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Настройки сохраняются в %AppData%\MimiTap\settings.json" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Выход" Click="ExitApp" />
                        <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="10,0,0,0" Click="SaveSettings" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>